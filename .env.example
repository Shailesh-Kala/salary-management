NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://user:pass@localhost:5432/salary_management
TEST_DATABASE_URL=postgres://user:pass@localhost:5432/salary_management_test
JWT_SECRET=change-me-to-a-random-32+-char-string
APP_TIMEZONE=Asia/Kolkata
COOKIE_SECURE=false
CORS_ORIGIN=http://localhost:5173
# SPA origin; export email links point to $APP_BASE_URL/exports/:id
APP_BASE_URL=http://localhost:5173
# Test inbox only — never a real mail server. Mailtrap Sandbox (from Inboxes → SMTP settings):
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your-mailtrap-username
SMTP_PASS=your-mailtrap-password
# Mailpit alternative (no auth): SMTP_HOST=localhost SMTP_PORT=1025, leave SMTP_USER/SMTP_PASS empty
SMTP_FROM="Salary Management <no-reply@acme.local>"
SEED_ADMIN_EMAIL=hr@acme.local
SEED_ADMIN_PASSWORD=change-me
