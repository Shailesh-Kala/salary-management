{
  "name": "server",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node --env-file-if-exists=../.env src/main.ts",
    "dev": "node --env-file-if-exists=../.env --watch src/main.ts",
    "migrate": "node --env-file-if-exists=../.env scripts/migrate.ts",
    "user:create": "node --env-file-if-exists=../.env scripts/user.ts create",
    "user:reset-password": "node --env-file-if-exists=../.env scripts/user.ts reset-password",
    "user:disable": "node --env-file-if-exists=../.env scripts/user.ts disable",
    "user:enable": "node --env-file-if-exists=../.env scripts/user.ts enable",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.10",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "supertest": "7.3.1"
  },
  "dependencies": {
    "cookie-parser": "1.4.7",
    "cors": "2.8.6",
    "express": "5.3.0",
    "express-rate-limit": "8.7.1",
    "helmet": "8.3.0",
    "jose": "6.2.12",
    "node-pg-migrate": "9.0.0",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "zod": "4.6.6"
  }
}
